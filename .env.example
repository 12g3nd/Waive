# ─────────────────────────────────────────────────────────────────────────────
# Waive / Backstop — configuration
#
# No paid cloud API is required. The LLM layer (vision extraction, plain-language
# explanation, translation, document drafting) runs against a LOCAL Ollama server.
# If Ollama is unreachable, the engine degrades gracefully to each sample's
# precomputed extraction + deterministic-driven draft text, so the demo still runs.
#
# For an ONLINE deploy with working uploads and no local model, use Claude instead
# (Anthropic API) — set ANTHROPIC_API_KEY below.
# ─────────────────────────────────────────────────────────────────────────────

# ── Provider: Claude (Anthropic) — the online path ──────────────────────────
# When ANTHROPIC_API_KEY is set, the app uses Claude to read uploaded notices
# (images AND PDFs) and to explain/translate/draft. Get a key at
# https://console.anthropic.com. Selected automatically when the key is present;
# force a provider with LLM_PROVIDER=anthropic | ollama.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=anthropic

# Claude model. Default is the most capable. On a small credit budget, the cheaper
# claude-haiku-4-5 (~5x cheaper) or claude-sonnet-4-6 stretch credits much further.
# ANTHROPIC_MODEL=claude-opus-4-8

# ── Provider: Ollama (local, no-cost) ───────────────────────────────────────
# Base URL of your running Ollama server (https://ollama.com).
OLLAMA_BASE_URL=http://localhost:11434

# Model for VISION extraction of an uploaded notice image/PDF page.
# Must be a multimodal model. Examples: llama3.2-vision, qwen2.5vl, llava, granite3.2-vision
MODEL_EXTRACT=llama3.2-vision

# Model for plain-language explanation, EN<->ES translation, and document drafting.
# Any capable text model. Examples: llama3.2, qwen2.5, mistral
MODEL_DRAFT=llama3.2

# Request timeout (ms) for a single Ollama call before falling back to offline mode.
LLM_TIMEOUT_MS=60000

# Force offline mode (1 = never call Ollama, always use precomputed extractions).
# The app auto-falls-back to offline when Ollama is unreachable; this just forces it.
LLM_OFFLINE=0

# Which U.S. state / jurisdiction the `answer` (debt) pack is configured for.
# This build ships an ONTARIO (Canada) configuration. Informational only.
ANSWER_JURISDICTION=ON-CA
